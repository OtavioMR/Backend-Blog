# Ambiente: development, production ou test; porta HTTP entre 1 e 65535.
NODE_ENV=development
PORT=3000

# Banco de Dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_NAME=nome_banco

# JWT: gere dois segredos aleatórios distintos com pelo menos 32 caracteres.
# Expiração em segundos; padrão: 900 para acesso e 604800 para refresh.
JWT_SECRET=gere-um-segredo-aleatorio-unico-com-32-caracteres
JWT_EXPIRES_IN=900
JWT_REFRESH_SECRET=gere-outro-segredo-aleatorio-unico-com-32-caracteres
JWT_REFRESH_EXPIRES_IN=604800

# SMTP obrigatório para envio de recuperação de senha; porta entre 1 e 65535.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-de-16-digitos
SMTP_FROM="Blog <seu-email@gmail.com>"
# URL HTTP(S) do frontend usada nos links de recuperação.
FRONTEND_URL=http://localhost:5173
