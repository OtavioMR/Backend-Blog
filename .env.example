# Ambiente: development, production ou test; porta HTTP entre 1 e 65535.
NODE_ENV=development
PORT=3000

# Banco de Dados
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_NAME=nome_banco
# PostgreSQL externo: habilite TLS com validação de certificado. Para a rede
# privada do Render, configure conforme a conexão fornecida pelo provedor.
DB_SSL=false
# CA PEM opcional; quebras de linha também podem ser escritas como \n.
# DB_SSL_CA=certificado-CA-do-provedor

# JWT: gere dois segredos aleatórios distintos com pelo menos 32 caracteres.
# Expiração em segundos; padrão: 900 para acesso e 604800 para refresh.
JWT_SECRET=gere-um-segredo-aleatorio-unico-com-32-caracteres
JWT_EXPIRES_IN=900
JWT_REFRESH_SECRET=gere-outro-segredo-aleatorio-unico-com-32-caracteres
JWT_REFRESH_EXPIRES_IN=604800

# SMTP obrigatório para envio de recuperação de senha; porta entre 1 e 65535.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-de-16-digitos
SMTP_FROM="Blog <seu-email@gmail.com>"

# Redis para fila e cache; use rediss:// e autenticação quando acessível pela rede.
# A fila contém temporariamente endereços e tokens de uso único.
REDIS_URL=redis://127.0.0.1:6379
# URL HTTP(S) do frontend usada nos links de recuperação e na origem CORS.
# A aplicação confia em exatamente um proxy reverso; configure-o para sobrescrever
# X-Forwarded-For e impeça acesso direto à aplicação em produção.
FRONTEND_URL=http://localhost:5173
# Endereço público da API para links de confirmação e cancelamento da newsletter.
PUBLIC_API_URL=http://localhost:3000

# TOTP opcional: chave aleatória de 32 bytes em hexadecimal (64 caracteres).
# Preserve a mesma chave para continuar acessando os segredos já cadastrados.
# TOTP_ENCRYPTION_KEY=gere-64-caracteres-hexadecimais

# Login social opcional: registre exatamente estas URLs no respectivo provedor.
# Em produção, os callbacks devem usar HTTPS.
# GOOGLE_CLIENT_ID=seu-client-id
# GOOGLE_CLIENT_SECRET=seu-client-secret
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/social/google/callback
# GITHUB_CLIENT_ID=seu-client-id
# GITHUB_CLIENT_SECRET=seu-client-secret
# GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/social/github/callback

# Fuso usado na serialização de datas (padrão: America/Sao_Paulo).
# APP_TIMEZONE=America/Sao_Paulo
# Telemetria OTLP opcional.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
